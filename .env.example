# Copy to .env.local for development. In production this file lives at ~/apps/acm-media/shared/.env (chmod 600).
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:5180
PORT=3080
DATABASE_URL=postgres://acm:acm@127.0.0.1:55496/acm_media
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=
OTP_PEPPER=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ACM Library <noreply@qu.acm.org>"
# Development: print OTP mails to the API log instead of sending them.
MAIL_TRANSPORT=log
MEDIA_ROOT=./.data/media
KEYS_DIR=./.data/keys
FFMPEG=ffmpeg
FFPROBE=ffprobe
PYTHON=./py/mediaworker/.venv/bin/python
LUTS_DIR=./luts
UPLOAD_MAX_BYTES=21474836480
UPLOAD_CHUNK_BYTES=8388608
# Comma-separated admin emails allowed to sign in before launch; empty = everyone active.
PRELAUNCH_ALLOWLIST=
# Comma-separated emails of the super admins: the only ones who can make or remove admins (they must be admins too).
SUPERADMINS=tech@qu.acm.org
